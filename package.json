{
  "name": "lxy-personal-homepage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --root ./site --config ../astro.config.mjs --host 127.0.0.1",
    "check": "astro check --root ./site --config ../astro.config.mjs",
    "build": "astro build --root ./site --config ../astro.config.mjs",
    "preview": "astro preview --root ./site --config ../astro.config.mjs --host 127.0.0.1 --port 4321",
    "test:browser": "node scripts/validate-site.cjs"
  },
  "dependencies": {
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "puppeteer-core": "^25.12.0",
    "typescript": "5.9.3"
  }
}
