---
import Arrow from "../components/Arrow.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { caseStudies } from "../data/profile";

const title = "项目 · Lxy";
const description = "李兴宇的项目案例：CodeS、MoniFlow、实习项目与个人作品，包含职责、技术贡献和公开边界。";
---

<BaseLayout title={title} description={description} page="work">
  <section class="band page-intro-band" id="top" aria-labelledby="page-title">
    <div class="shell page-intro">
      <p class="eyebrow hero-reveal" style="--order: 0">WORK / 07 CASES</p>
      <h1 id="page-title" class="hero-reveal" style="--order: 1">项目不是技术名词的集合，<br /><em>而是问题、取舍与交付。</em></h1>
      <div class="page-intro-aside hero-reveal" style="--order: 2">
        <p>四段实习与两个个人项目。公司项目只展示可公开的职责和机制，不提供内部代码、系统入口或原始数据。</p>
        <a class="text-link" href="/notes">继续看工程复盘<Arrow /></a>
      </div>
    </div>
  </section>

  <section class="band work-page-band" aria-label="项目案例" data-reveal>
    <div class="shell work-page-grid">
      <aside class="work-sidebar">
        <p class="eyebrow">CASE INDEX</p>
        {["实习项目", "个人项目"].map(kind => (
          <div class="index-group">
            <span>{kind}</span>
            {caseStudies.filter(project => project.kind === kind).map(project => (
              <a href={`#${project.id}`} data-case-nav={project.id}>{project.name}<Arrow /></a>
            ))}
          </div>
        ))}
      </aside>

      <div class="case-list">
        {caseStudies.map((project, index) => (
          <article class="case-study" id={project.id} aria-labelledby={`${project.id}-title`} data-company={project.owner === "字节跳动" ? "bytedance" : undefined}>
            <div class="case-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</div>
            <div class="case-content">
              <div class="case-meta"><span>{project.owner} · {project.kind}</span><span>{project.role}</span></div>
              <div class="case-title-row">
                <h2 id={`${project.id}-title`}>{project.name}</h2>
                {project.source && <a class="source-link" href={project.source} target="_blank" rel="noreferrer">GitHub 源码<Arrow diagonal /></a>}
              </div>
              <h3>{project.title}</h3>
              <p class="case-description">{project.description}</p>
              <dl class="contributions">
                {project.highlights.map(highlight => <div><dt>{highlight.label}</dt><dd>{highlight.text}</dd></div>)}
              </dl>
              {project.result && <p class="case-result">{project.result}</p>}
              {project.scope && <p class="scope-note">{project.scope}</p>}
              <ul class="tags" aria-label="项目技术">{project.tags.map(tag => <li>{tag}</li>)}</ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band next-band" data-reveal>
    <div class="shell next-grid">
      <p class="eyebrow">NEXT</p>
      <h2>从项目结果，继续进入问题现场。</h2>
      <a class="text-link strong-link" href="/notes">阅读工程复盘<Arrow /></a>
    </div>
  </section>
</BaseLayout>
