---
import Arrow from "../components/Arrow.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { capabilityMap, engineeringNotes, experience, featuredProjects, profile } from "../data/profile";

const title = "Lxy · 李兴宇 — 后端与 Agent 工程";
const description = "李兴宇，东华大学计算机专硕，2028 届。四段实习，关注 Agent Runtime、可靠执行、自动化与后端平台工程。";
---

<BaseLayout title={title} description={description} page="home">
  <section class="band hero-band" id="top" aria-labelledby="intro-title">
    <div class="shell home-hero">
      <div class="hero-copy">
        <p class="eyebrow hero-reveal" style="--order: 0"><span class="status-dot" aria-hidden="true"></span>Backend / Agent Engineering</p>
        <h1 id="intro-title" class="hero-reveal" style="--order: 1">
          <span>{profile.name}</span>
          <em>{profile.englishName}<i>.</i></em>
        </h1>
        <p class="hero-role hero-reveal" style="--order: 2">有 Agent 工程经验的后端开发者。</p>
        <p class="hero-summary hero-reveal" style="--order: 3">从代码分析和执行框架，到任务控制面与完整产品交付。</p>
        <div class="hero-meta hero-reveal" style="--order: 4">
          <span>{profile.education}</span>
          <span>{profile.graduation} 届</span>
        </div>
        <div class="hero-actions hero-reveal" style="--order: 5">
          <a class="text-link strong-link" href="/work">查看项目<Arrow /></a>
          <a class="text-link" href={`mailto:${profile.email}`}>联系我<Arrow diagonal /></a>
        </div>
      </div>

      <section class="experience-overview hero-reveal" style="--order: 3" aria-labelledby="experience-title">
        <div class="section-kicker">
          <h2 id="experience-title">四段实习，持续深入工程现场</h2>
          <span>EXPERIENCE · 04</span>
        </div>
        <div class="experience-list">
          {experience.map((item, index) => (
            <a class="experience-link" href={`/work#${item.target}`} aria-label={`${item.company} · 查看项目介绍`}>
              <span class="row-index">0{index + 1}</span>
              <div>
                <h3>{item.company}<span>{item.role}</span></h3>
                <p>{item.summary}</p>
              </div>
              <Arrow />
            </a>
          ))}
        </div>
      </section>
    </div>
    <div class="hero-edge shell" aria-hidden="true"><span>Selected work below</span><i></i></div>
  </section>

  <section class="band selected-work-band" aria-labelledby="selected-work-title" data-reveal>
    <div class="shell band-grid">
      <header class="band-heading">
        <p class="eyebrow">01 / SELECTED WORK</p>
        <h2 id="selected-work-title">把经历落到<br />可追问的项目<span>。</span></h2>
        <p>项目背景、我的职责、关键机制和公开边界，集中放在 Work。</p>
        <a class="text-link" href="/work">全部项目<Arrow /></a>
      </header>
      <div class="work-index">
        {featuredProjects.map((project, index) => (
          <article class="work-row">
            <span class="row-index">0{index + 1}</span>
            <div class="work-row-main">
              <p class="row-kicker">{project.kind}</p>
              <h3>{project.name}</h3>
              <p>{project.description}</p>
              <small>{project.highlight}</small>
            </div>
            <div class="work-row-links">
              {project.introductions.map(link => <a href={`/work#${link.target}`}>{link.label}<Arrow /></a>)}
              {project.source && <a href={project.source} target="_blank" rel="noreferrer">源码<Arrow diagonal /></a>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band notes-preview-band" aria-labelledby="notes-title" data-reveal>
    <div class="shell">
      <header class="notes-preview-heading">
        <div>
          <p class="eyebrow signal">02 / ENGINEERING NOTES</p>
          <h2 id="notes-title">不只展示结果，也解释问题为什么发生。</h2>
        </div>
        <a class="text-link light-link" href="/notes">阅读全部复盘<Arrow /></a>
      </header>
      <div class="notes-preview-list">
        {engineeringNotes.map(note => (
          <a class="note-preview" href={`/notes#${note.id}`}>
            <span>{note.number}</span>
            <div><small>{note.category}</small><h3>{note.title}</h3></div>
            <p>{note.summary}</p>
            <Arrow />
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="band capability-band" aria-labelledby="capability-title" data-reveal>
    <div class="shell">
      <header class="capability-heading">
        <p class="eyebrow">03 / CAPABILITY MAP</p>
        <h2 id="capability-title">能力不是百分比，<br />而是一组可以回到证据的连接。</h2>
      </header>
      <div class="capability-map">
        {capabilityMap.map((capability, index) => (
          <a class="capability-row" href={capability.href}>
            <span class="capability-code">C{index + 1}</span>
            <h3>{capability.name}</h3>
            <p>{capability.statement}</p>
            <span class="capability-evidence">{capability.evidence}<Arrow /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="band contact-band" id="contact" aria-labelledby="contact-title" data-reveal>
    <div class="shell contact-grid">
      <div>
        <p class="eyebrow">04 / CONTACT</p>
        <h2 id="contact-title">关注后端开发与<br />Agent 工程机会<span>。</span></h2>
      </div>
      <div class="contact-actions">
        <a class="email-link" href={`mailto:${profile.email}`}>{profile.email}<Arrow diagonal /></a>
        <div class="contact-secondary">
          <a href={profile.github} target="_blank" rel="noreferrer">GitHub / git-damboro<Arrow diagonal /></a>
          <button type="button" data-copy-email={profile.email} hidden>复制邮箱</button>
        </div>
        <span class="copy-status" role="status" aria-live="polite"></span>
      </div>
    </div>
  </section>
</BaseLayout>
